---
import type { PricingOptionGroup } from '../lib/schema/types';

interface Props {
  pricingOptions: PricingOptionGroup[];
}

const { pricingOptions } = Astro.props;
const columns = ['Type', 'Price / Person', 'Accomodation'];
---

<div class="price-section mb-[8mm]">
  <h2 class="text-[9.5mm] font-bold tracking-tight mb-[5mm] font-display font-extrabold text-black">
    PRICE INFORMATION
  </h2>

  {pricingOptions.map((option) => (
    <div class="price-option-group mb-[6mm] break-inside-avoid">
      <div class="font-display font-bold text-[3.8mm] mt-[4mm] mb-[2.5mm] text-black">
        {option.label}
      </div>

      <table class="w-full border-collapse text-[3.7mm]">
        <thead>
          <tr>
            {columns.map((col) => (
              <th class="border-[.5mm] border-black px-[4mm] py-[3.5mm] h-[14mm] font-normal text-left text-black bg-white">
                {col}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {option.rows.map((row) => (
            row.stays.length > 0 ? (
              row.stays.map((stay, idx) => (
                <tr>
                  {idx === 0 && (
                    <>
                      <td
                        class="border-[.5mm] border-black px-[4mm] w-[45mm] text-center h-[13.5mm] text-black bg-white align-middle"
                        rowspan={row.stays.length}
                      >
                        {row.type}
                      </td>
                      <td
                        class="border-[.5mm] border-black px-[4mm] w-[45mm] text-black bg-white align-middle"
                        rowspan={row.stays.length}
                      >
                        {row.price}
                      </td>
                    </>
                  )}
                  <td class="border-[.5mm] border-black px-[4mm] h-[13.5mm] text-black bg-white align-middle">
                    {stay}
                  </td>
                </tr>
              ))
            ) : (
              <tr>
                <td class="border-[.5mm] border-black px-[4mm] w-[45mm] text-center h-[13.5mm] text-black bg-white align-middle">
                  {row.type}
                </td>
                <td class="border-[.5mm] border-black px-[4mm] w-[45mm] text-black bg-white align-middle">
                  {row.price}
                </td>
                <td class="border-[.5mm] border-black px-[4mm] h-[13.5mm] text-black bg-white align-middle">
                  -
                </td>
              </tr>
            )
          ))}
        </tbody>
      </table>
    </div>
  ))}
</div>

<style>
  .price-option-group {
    break-inside: avoid;
    page-break-inside: avoid;
  }
</style>
