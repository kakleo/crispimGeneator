---
import type { SiteSettings } from '../lib/schema/types';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
---

<div class="footer-bar absolute inset-x-0 bottom-0 h-[11mm] bg-green flex justify-center items-center gap-[12mm] text-[4mm] text-white">
  <span class="flex items-center gap-[2.5mm]">
    <svg class="w-[5.5mm] h-[5.5mm] fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="9.5"></circle>
      <path d="M2.5 12h19M12 2.5c3 3 3 16 0 19M12 2.5c-3 3-3 16 0 19"></path>
    </svg>
    <span>{settings.website}</span>
  </span>
  <span class="flex items-center gap-[2.5mm]">
    <svg class="w-[5.5mm] h-[5.5mm] fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24">
      <path d="M4 20l1.3-4.2A8.5 8.5 0 1 1 8.4 18.8z"></path>
      <path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z"></path>
    </svg>
    <span>{settings.whatsapp}</span>
  </span>
  <span class="flex items-center gap-[2.5mm]">
    <svg class="w-[5.5mm] h-[5.5mm] fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.2" cy="6.8" r=".6"></circle>
    </svg>
    <span>{settings.instagram}</span>
  </span>
</div>

<style>
  @media print {
    .footer-bar {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
