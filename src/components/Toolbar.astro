---
import type { ProposalDocument } from '../lib/schema/types';

interface Props {
  proposal: ProposalDocument;
}

const { proposal } = Astro.props;
const { meta, validation, isStale, lastUpdated } = proposal;
const isExportable = validation.isValid && meta.status !== 'archived';
const isDraft = meta.status === 'draft';
---

<header class="no-print sticky top-0 z-50 bg-white/95 backdrop-blur-sm text-zinc-900 shadow-sm border-b border-zinc-200">
  <div class="max-w-7xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3">
    <!-- Left: Navigation & Title -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-medium text-zinc-700 hover:text-zinc-900 px-3 py-1.5 rounded-md bg-white hover:bg-zinc-100 border border-zinc-200 shadow-xs transition"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Proposals</span>
      </a>
      <div class="flex items-center gap-2">
        <span class="font-semibold text-sm tracking-tight text-zinc-900">
          {meta.title}
        </span>
        {meta.version && (
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-zinc-100 text-zinc-600 border border-zinc-200">
            {meta.version}
          </span>
        )}
      </div>

      <!-- Status Badge -->
      {meta.status === 'ready' && (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Ready
        </span>
      )}
      {meta.status === 'draft' && (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
          Draft
        </span>
      )}
      {meta.status === 'archived' && (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-zinc-100 text-zinc-600 border border-zinc-200">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
          Archived
        </span>
      )}

      <!-- Stale Data Warning -->
      {isStale && (
        <span
          class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-50 text-rose-700 border border-rose-200"
          title="Google Sheets API unavailable; using last good cached data"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          Stale Data
        </span>
      )}
    </div>

    <!-- Right: Actions & Last Updated -->
    <div class="flex items-center gap-2">
      {lastUpdated && (
        <span class="text-xs text-zinc-400 hidden sm:inline mr-1">
          Updated {new Date(lastUpdated).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
        </span>
      )}

      <!-- Refresh Button -->
      <button
        id="btn-refresh"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-white hover:bg-zinc-100 text-zinc-700 border border-zinc-200 shadow-xs transition cursor-pointer"
        title="Force refresh Google Sheet data"
      >
        <svg id="refresh-icon" class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        <span>Refresh</span>
      </button>

      <!-- Browser Print Button (FR-23) -->
      <button
        onclick="window.print()"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-white hover:bg-zinc-100 text-zinc-700 border border-zinc-200 shadow-xs transition cursor-pointer"
        title="Print with browser dialog"
      >
        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
        </svg>
        <span>Print</span>
      </button>

      <!-- Download PDF Button (FR-18, FR-21, FR-31) -->
      {isExportable ? (
        <a
          href={`/p/${meta.proposal_id}/pdf`}
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium rounded-md bg-zinc-900 hover:bg-zinc-800 text-white shadow-sm transition"
          download
        >
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download PDF</span>
        </a>
      ) : (
        <button
          disabled
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md bg-zinc-100 text-zinc-400 border border-zinc-200 cursor-not-allowed"
          title="PDF export blocked due to validation errors or archived status"
        >
          PDF Blocked
        </button>
      )}

      <!-- Logout -->
      <form action="/api/logout" method="POST" class="inline">
        <button
          type="submit"
          class="text-xs font-medium text-zinc-500 hover:text-zinc-900 px-2 py-1.5 rounded-md hover:bg-zinc-100 transition cursor-pointer"
          title="Sign out"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>

  <!-- Draft Notice Watermark Banner -->
  {isDraft && (
    <div class="bg-amber-50 border-y border-amber-200 text-amber-800 px-4 py-1.5 text-center text-xs font-semibold tracking-wide">
      &bull; DRAFT PROPOSAL &bull; FOR INTERNAL REVIEW ONLY &bull;
    </div>
  )}

  <!-- Blocking Errors Alert Banner (FR-30, FR-31) -->
  {validation.errors.length > 0 && (
    <div class="bg-rose-50 border-t border-rose-200 text-rose-900 px-4 py-2.5 text-xs">
      <div class="max-w-7xl mx-auto flex items-start gap-2">
        <svg class="w-4 h-4 text-rose-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        <div>
          <b class="font-semibold text-rose-900">Blocking Validation Errors (PDF export disabled):</b>
          <ul class="list-disc pl-5 mt-1 space-y-0.5 text-rose-800">
            {validation.errors.map((err) => (
              <li>
                <span class="font-medium text-rose-950">{err.tab}</span> row <span class="font-mono font-bold text-rose-950">{err.row}</span>, column <span class="font-mono font-medium text-rose-950">{err.column}</span>: {err.message}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )}

  <!-- Non-blocking Warnings Banner (FR-31) -->
  {validation.warnings.length > 0 && (
    <div class="bg-amber-50 border-t border-amber-200 text-amber-900 px-4 py-2 text-xs">
      <div class="max-w-7xl mx-auto flex items-start gap-2">
        <svg class="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <b class="font-semibold text-amber-900">Data Quality Warnings:</b>
          <ul class="list-disc pl-5 mt-1 space-y-0.5 text-amber-800">
            {validation.warnings.map((w) => (
              <li>
                {w.tab}{w.row ? ` row ${w.row}` : ''}: {w.message}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  )}
</header>

<script>
  const refreshBtn = document.getElementById('btn-refresh');
  const refreshIcon = document.getElementById('refresh-icon');

  if (refreshBtn) {
    refreshBtn.addEventListener('click', async () => {
      if (refreshIcon) refreshIcon.classList.add('animate-spin');
      refreshBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/refresh', { method: 'POST' });
        if (res.ok) {
          window.location.reload();
        } else {
          const errData = await res.json().catch(() => ({}));
          alert(`Failed to refresh data: ${errData.error || res.statusText}`);
        }
      } catch (err: any) {
        alert(`Network error while refreshing: ${err?.message || 'Connection failed'}`);
      } finally {
        if (refreshIcon) refreshIcon.classList.remove('animate-spin');
        refreshBtn.removeAttribute('disabled');
      }
    });
  }
</script>

<style>
  @media print {
    .no-print {
      display: none !important;
    }
  }
</style>
