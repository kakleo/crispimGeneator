---
import { getSiteSettings, SITE_SETTINGS } from '../lib/settings';

const settings = getSiteSettings();
const currentUser = Astro.locals.user || 'Staff';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Company Settings - Nusa Flores Travel</title>
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
  </style>
</head>
<body class="bg-zinc-50 text-zinc-900 min-h-screen">
  <!-- Top Navigation Bar -->
  <nav class="bg-white border-b border-zinc-200 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="h-9 flex items-center justify-center">
          <img src="/logo.png" alt="Nusa Flores Travel" class="max-h-9 max-w-[130px] object-contain" />
        </a>
        <div class="border-l border-zinc-200 pl-3">
          <h1 class="font-semibold text-sm text-zinc-900 tracking-tight leading-none">Branding & Settings</h1>
          <p class="text-xs text-zinc-500 mt-1">Application constants excluded from Google Sheets</p>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-md bg-white hover:bg-zinc-100 text-zinc-700 border border-zinc-200 shadow-xs transition"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Dashboard</span>
        </a>
        <form action="/api/logout" method="POST">
          <button
            type="submit"
            class="text-xs font-medium text-zinc-500 hover:text-zinc-900 px-2 py-1.5 rounded-md hover:bg-zinc-100 transition cursor-pointer"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900">Active Company Information</h2>
      <p class="text-sm text-zinc-500 mt-1">
        These settings are stored as code constants in <code class="text-zinc-800 bg-zinc-200/70 px-1.5 py-0.5 rounded text-xs font-mono">src/lib/settings.ts</code> so your Google Sheet remains a clean, single-tab database for tour proposals only.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Info Card -->
      <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-xs">
        <h3 class="text-sm font-semibold text-zinc-900 mb-4 pb-3 border-b border-zinc-100 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span>Company & Contact Info</span>
        </h3>

        <dl class="space-y-4 text-sm">
          <div>
            <dt class="text-[11px] uppercase font-semibold text-zinc-400 tracking-wider">Company Name</dt>
            <dd class="text-zinc-900 font-medium text-sm mt-0.5">{settings.company_name}</dd>
          </div>

          <div>
            <dt class="text-[11px] uppercase font-semibold text-zinc-400 tracking-wider">Official Website</dt>
            <dd class="text-zinc-900 font-medium text-sm mt-0.5">
              <a href={`https://${settings.website}`} target="_blank" class="text-emerald-700 hover:underline">
                {settings.website}
              </a>
            </dd>
          </div>

          <div>
            <dt class="text-[11px] uppercase font-semibold text-zinc-400 tracking-wider">WhatsApp Contact</dt>
            <dd class="text-zinc-900 font-medium text-sm mt-0.5">{settings.whatsapp}</dd>
          </div>

          <div>
            <dt class="text-[11px] uppercase font-semibold text-zinc-400 tracking-wider">Instagram Handle</dt>
            <dd class="text-zinc-900 font-medium text-sm mt-0.5">@{settings.instagram}</dd>
          </div>

          <div>
            <dt class="text-[11px] uppercase font-semibold text-zinc-400 tracking-wider">Custom Logo URL</dt>
            <dd class="text-zinc-900 font-medium text-xs mt-0.5 font-mono">
              {settings.logo_url || '/logo.png (Default)'}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Colors & Brand Visuals -->
      <div class="bg-white rounded-xl border border-zinc-200 p-6 shadow-xs flex flex-col justify-between">
        <div>
          <h3 class="text-sm font-semibold text-zinc-900 mb-4 pb-3 border-b border-zinc-100 flex items-center gap-2">
            <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
            </svg>
            <span>Brand Colors</span>
          </h3>

          <div class="space-y-3 mb-6">
            <div class="flex items-center justify-between p-3 rounded-lg bg-zinc-50 border border-zinc-200">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-md shadow-xs border border-zinc-300" style={`background-color: ${settings.primary_green}`}></span>
                <span class="text-xs font-medium text-zinc-900">Primary Green (Footer & Inclusions)</span>
              </div>
              <span class="font-mono text-xs text-zinc-500">{settings.primary_green}</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-lg bg-zinc-50 border border-zinc-200">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-md shadow-xs border border-zinc-300" style={`background-color: ${settings.accent_blue}`}></span>
                <span class="text-xs font-medium text-zinc-900">Accent Blue (Day Banners)</span>
              </div>
              <span class="font-mono text-xs text-zinc-500">{settings.accent_blue}</span>
            </div>

            <div class="flex items-center justify-between p-3 rounded-lg bg-zinc-50 border border-zinc-200">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-md shadow-xs border border-zinc-300" style={`background-color: ${settings.exclude_red}`}></span>
                <span class="text-xs font-medium text-zinc-900">Exclude Red (Exclusion Badges)</span>
              </div>
              <span class="font-mono text-xs text-zinc-500">{settings.exclude_red}</span>
            </div>
          </div>
        </div>

        <!-- Live Footer Preview Box -->
        <div>
          <span class="block text-[11px] uppercase font-semibold text-zinc-400 tracking-wider mb-2">Live Footer Preview</span>
          <div class="rounded-lg overflow-hidden border border-zinc-200 shadow-xs">
            <div class="h-10 bg-green flex justify-center items-center gap-6 text-xs text-white">
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19M12 2.5c3 3 3 16 0 19M12 2.5c-3 3-3 16 0 19"></path></svg>
                <span>{settings.website}</span>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24"><path d="M4 20l1.3-4.2A8.5 8.5 0 1 1 8.4 18.8z"></path><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z"></path></svg>
                <span>{settings.whatsapp}</span>
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 fill-none stroke-white stroke-[1.6]" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".6"></circle></svg>
                <span>{settings.instagram}</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Code Constant Reference -->
    <div class="mt-8 bg-white rounded-xl border border-zinc-200 p-6 shadow-xs">
      <h3 class="text-sm font-semibold text-zinc-900 mb-1">Source Code Constant (<code class="text-xs text-zinc-700 bg-zinc-100 px-1.5 py-0.5 rounded font-mono">src/lib/settings.ts</code>)</h3>
      <p class="text-xs text-zinc-500 mb-4">
        To modify these values in code, simply edit <code class="font-mono text-zinc-700">src/lib/settings.ts</code>, or set environment variables in your <code class="font-mono text-zinc-700">.env</code> file.
      </p>
      <pre class="bg-zinc-900 p-4 rounded-lg text-xs font-mono text-emerald-400 overflow-x-auto border border-zinc-800">
{`export const SITE_SETTINGS: SiteSettings = {
  company_name: '${settings.company_name}',
  website: '${settings.website}',
  whatsapp: '${settings.whatsapp}',
  instagram: '${settings.instagram}',
  logo_url: '${settings.logo_url}',
  primary_green: '${settings.primary_green}',
  accent_blue: '${settings.accent_blue}',
  exclude_red: '${settings.exclude_red}',
};`}
      </pre>
    </div>
  </main>
</body>
</html>
