---
import { fetchSheetData } from '../../../lib/sheets/client';
import { getTermsHtml } from '../../../lib/terms';
import { validateAndParseProposal } from '../../../lib/schema/validator';
import Toolbar from '../../../components/Toolbar.astro';
import Cover from '../../../components/Cover.astro';
import GeneralInfo from '../../../components/GeneralInfo.astro';
import DayBlock from '../../../components/DayBlock.astro';
import PriceTable from '../../../components/PriceTable.astro';
import IncludeExclude from '../../../components/IncludeExclude.astro';
import Terms from '../../../components/Terms.astro';
import Footer from '../../../components/Footer.astro';

const { proposal_id } = Astro.params;

if (!proposal_id) {
  return Astro.redirect('/');
}

// Fetch sheet data (with caching)
const { data, isStale, lastUpdated } = await fetchSheetData();
const termsHtml = getTermsHtml();

const proposal = validateAndParseProposal(proposal_id, data, termsHtml, isStale);

if (!proposal) {
  return new Response(`Proposal "${proposal_id}" not found in sheet`, { status: 404 });
}

const { meta, settings, itinerary, pricingOptions, inclusions, extraInfoRows, introParagraphs, sanitizedHtml } = proposal;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title} - Nusa Flores Travel</title>
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    @page {
      size: A4;
      margin: 0;
    }
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Print optimizations (FR-18, FR-19, FR-20, FR-22) */
    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      body {
        background-color: #ffffff !important;
        padding: 0 !important;
        zoom: 1 !important;
      }
      .no-print {
        display: none !important;
      }
      .page-container {
        box-shadow: none !important;
        margin: 0 !important;
        page-break-after: always;
        break-after: page;
      }
      .flowing-content-page {
        padding-bottom: 15mm !important;
      }
      .fixed-print-footer {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        height: 11mm !important;
        display: flex !important;
        z-index: 9999 !important;
      }
    }

    /* Mobile Scaling (FR-17) */
    @media screen and (max-width: 215mm) {
      .preview-viewport {
        zoom: 0.48;
      }
    }
    @media screen and (max-width: 480px) {
      .preview-viewport {
        zoom: 0.42;
      }
    }
  </style>
</head>
<body class="bg-zinc-100 print:bg-white text-zinc-900 min-h-screen">
  <!-- Toolbar outside printable area -->
  <Toolbar proposal={proposal} />

  <!-- Preview Viewport -->
  <div class="preview-viewport py-6 print:py-0 flex flex-col items-center">
    <!-- PAGE 1: COVER -->
    <Cover meta={meta} settings={settings} />

    <!-- PAGE 2+: FLOWING CONTENT DOCUMENT -->
    <!-- Page 2: General Information & Itinerary Start -->
    <section class="page-container relative w-[210mm] min-h-[297mm] mx-auto mb-6 bg-white overflow-hidden shadow-lg print:shadow-none print:m-0 print:break-after-page flex flex-col justify-between">
      <div class="pt-[12mm] px-[9mm] pb-[16mm] flex-1">
        <!-- General Info -->
        <GeneralInfo
          meta={meta}
          introParagraphs={introParagraphs}
          extraInfoRows={extraInfoRows}
        />

        <!-- Optional Custom HTML (FR-13) -->
        {sanitizedHtml && (
          <div class="custom-html-block mb-[6mm] p-[3mm] bg-[#f8f9fa] border border-[#e2e8f0] rounded">
            <Fragment set:html={sanitizedHtml} />
          </div>
        )}

        <!-- Itinerary Heading -->
        <h2 class="text-[9.5mm] font-bold tracking-tight mb-[5mm] text-black">
          TOUR ITINERARY
        </h2>

        <!-- Itinerary Days (First 2 days) -->
        {itinerary.slice(0, 2).map((day) => (
          <DayBlock day={day} />
        ))}
      </div>

      <!-- Page Footer -->
      <Footer settings={settings} />
    </section>

    <!-- Page 3: Remaining Itinerary Days (if more than 2 days) -->
    {itinerary.length > 2 && (
      <section class="page-container relative w-[210mm] min-h-[297mm] mx-auto mb-6 bg-white overflow-hidden shadow-lg print:shadow-none print:m-0 print:break-after-page flex flex-col justify-between">
        <div class="pt-[10mm] px-[9mm] pb-[16mm] flex-1">
          {itinerary.slice(2).map((day) => (
            <DayBlock day={day} />
          ))}
        </div>
        <Footer settings={settings} />
      </section>
    )}

    <!-- Page 4: Price Information -->
    <section class="page-container relative w-[210mm] min-h-[297mm] mx-auto mb-6 bg-white overflow-hidden shadow-lg print:shadow-none print:m-0 print:break-after-page flex flex-col justify-between">
      <div class="pt-[12mm] px-[14mm] pb-[16mm] flex-1">
        <PriceTable pricingOptions={pricingOptions} />
      </div>
      <Footer settings={settings} />
    </section>

    <!-- Page 5: Inclusions & Exclusions -->
    <section class="page-container relative w-[210mm] min-h-[297mm] mx-auto mb-6 bg-white overflow-hidden shadow-lg print:shadow-none print:m-0 print:break-after-page flex flex-col justify-between">
      <div class="pt-[12mm] px-[9mm] pb-[16mm] flex-1">
        <IncludeExclude
          include={inclusions.include}
          exclude={inclusions.exclude}
        />
      </div>
      <Footer settings={settings} />
    </section>

    <!-- Page 6: Terms of Service -->
    <section class="page-container relative w-[210mm] min-h-[297mm] mx-auto mb-6 bg-white overflow-hidden shadow-lg print:shadow-none print:m-0 print:break-after-page flex flex-col justify-between">
      <div class="pt-[12mm] px-[12mm] pb-[16mm] flex-1">
        <Terms termsHtml={proposal.termsHtml} />
      </div>
      <Footer settings={settings} />
    </section>
  </div>

  <script>
    if (new URLSearchParams(window.location.search).get('autoprint') === '1') {
      window.addEventListener('load', () => {
        setTimeout(() => window.print(), 600);
      });
    }
  </script>
</body>
</html>
